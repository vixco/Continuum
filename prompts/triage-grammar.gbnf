root ::= ignore | remember | whisper | exec | wake

ignore  ::= "{\"decision\":\"ignore\"}"
remember ::= "{\"decision\":\"remember\",\"summary\":" ws str "}"
whisper  ::= "{\"decision\":\"whisper\",\"text\":" ws str "}"
exec     ::= "{\"decision\":\"execute_simple\",\"action\":" ws str "}"
wake     ::= "{\"decision\":\"wake_orchestrator\",\"reason\":" ws str wake_tail "}"

# Optional suggested_skill hint — triage may add this when it knows a
# Continuum skill probably applies. The orchestrator treats it as advisory.
wake_tail ::= ( "," ws "\"suggested_skill\":" ws str )?

str ::= "\"" ([^"\\] | "\\" ["\\/bfnrt])* "\""
ws  ::= " "?
