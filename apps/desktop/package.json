{
  "name": "@continuum/desktop",
  "version": "0.1.0-alpha.11",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm test:desktop && next build",
    "start": "next start",
    "lint": "next lint",
    "test:chat": "node --experimental-strip-types --test tests/chat-tool-invocations.test.mjs",
    "test:logs": "node --experimental-strip-types --test tests/log-view.test.mjs",
    "test:ui": "node --test tests/ui-contract.test.mjs",
    "test:desktop": "pnpm test:chat && pnpm test:logs && pnpm test:ui",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.0.0",
    "clsx": "^2.1.1",
    "force-graph": "^1.51.4",
    "lucide-react": "^0.469.0",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7"
  }
}
