{
  "schema_version": 1,
  "suite_id": "continuum-bounded-autonomy-v1",
  "evidence_mode": "synthetic_contract_trace",
  "runtime_required": true,
  "scenarios": [
    {
      "id": "verified_write",
      "title": "Authorized mutation completes only after verified postcondition",
      "scope": {
        "capabilities": ["computer.click"],
        "targets": ["synthetic:settings-toggle"]
      },
      "budget": {
        "max_actions": 1,
        "max_attempts_per_step": 1,
        "max_elapsed_ms": 5000
      },
      "verify_each_step": true,
      "expected_terminal": "run_completed",
      "events": [
        {"seq": 1, "at_ms": 0, "type": "goal_proposed"},
        {"seq": 2, "at_ms": 10, "type": "scope_locked", "capabilities": ["computer.click"], "targets": ["synthetic:settings-toggle"]},
        {"seq": 3, "at_ms": 20, "type": "policy_authorized", "capability": "computer.click", "mode": "ask", "approval_id": "approval-synthetic-1", "approved": true},
        {"seq": 4, "at_ms": 30, "type": "lease_acquired", "lease_id": "lease-synthetic-1"},
        {"seq": 5, "at_ms": 40, "type": "step_checkpointed", "step_id": "toggle-observation", "attempt": 1},
        {"seq": 6, "at_ms": 50, "type": "step_dispatched", "step_id": "toggle-observation", "attempt": 1, "capability": "computer.click", "target": "synthetic:settings-toggle", "risk": "write", "idempotent": false},
        {"seq": 7, "at_ms": 120, "type": "postcondition_verified", "step_id": "toggle-observation", "attempt": 1, "result": "pass", "evidence_refs": ["synthetic:toggle-on"]},
        {"seq": 8, "at_ms": 130, "type": "step_completed", "step_id": "toggle-observation", "attempt": 1},
        {"seq": 9, "at_ms": 140, "type": "lease_released", "lease_id": "lease-synthetic-1"},
        {"seq": 10, "at_ms": 150, "type": "run_completed"}
      ]
    },
    {
