{
  "name": "continuum",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "dev:app": "pnpm --filter @continuum/desktop tauri dev",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build": "pnpm run build:desktop && pnpm run build:docs",
    "build:desktop": "pnpm --filter @continuum/desktop build",
    "build:docs": "pnpm --filter continuum-docs build",
    "typecheck": "pnpm --filter @continuum/desktop typecheck"
  }
}
